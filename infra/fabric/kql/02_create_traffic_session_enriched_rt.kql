.create-or-alter function traffic_session_enriched_rt() {
    store_events_raw
    | where isnotempty(tenant_id) and isnotempty(store_id)
    | extend
        ws  = iff(isnull(window_start), bin(timestamp, 5m), window_start),
        we  = iff(isnull(window_end), bin(timestamp, 5m) + 5m, window_end),
        ds  = todouble(coalesce(dwell_seconds, 0.0)),
        gvc = toint(coalesce(group_visitor_count, 0)),
        zv  = toint(coalesce(zone_visitors, 0)),
        pzf = tobool(coalesce(promo_zone_flag, false)),
        entry_count     = iff(event_type == "door_crossed" and direction == "entering", 1, 0),
        exit_count      = iff(event_type == "door_crossed" and direction == "exiting",  1, 0)
    | extend
        hv  = ds > 0.0,
        mdb = iff(
            isnotempty(max_dwell_bucket),
            max_dwell_bucket,
            case(
                ds < 30.0,  "<30s",
                ds < 60.0,  "30-60s",
                ds < 120.0, "60-120s",
                ">120s"
            )
        ),
        occupancy_delta = entry_count - exit_count
    | project
        tenant_id,
        store_id,
        window_start         = ws,
        window_end           = we,
        group_visitor_count  = gvc,
        zone_id,
        zone_visitors        = zv,
        dwell_seconds        = ds,
        has_dwell_flag       = hv,
        zone_session_id,
        has_transaction_flag = false,
        max_dwell_bucket     = mdb,
        promo_zone_flag      = pzf,
        entry_count,
        exit_count,
        occupancy_delta
}
