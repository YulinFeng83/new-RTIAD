.create-merge table store_events_raw (
    event_type:string,
    tenant_id:string,
    store_id:string,
    camera_id:string,
    timestamp:datetime,
    track_id:long,
    group_id:string,
    zone_id:string,
    direction:string,
    classification_label:string,
    employee_probability:real,
    customer_probability:real,
    unknown_probability:real,
    group_probability:real,
    dwell_seconds:real,
    zone_session_id:string,
    has_dwell_flag:bool,
    window_start:datetime,
    window_end:datetime,
    group_visitor_count:int,
    zone_visitors:int,
    max_dwell_bucket:string,
    promo_zone_flag:bool,
    event_id:string,
    store_visit_session_id:string,
    previous_group_id:string,
    session_completed_at:datetime,
    session_duration_seconds:real,
    total_dwell_seconds:real,
    session_entry_count:int,
    session_exit_count:int,
    visited_zones:dynamic
)
