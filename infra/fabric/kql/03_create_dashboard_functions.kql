.create-or-alter function
fn_current_occupancy() {
    traffic_session_enriched_rt()
    | summarize current_occupancy = sum(occupancy_delta)
      by tenant_id, store_id
}

.create-or-alter function
fn_entries_exits_24h() {
    traffic_session_enriched_rt()
    | where window_start >= ago(24h)
    | summarize
        entries = sum(entry_count),
        exits   = sum(exit_count)
      by tenant_id, store_id, window_start
    | order by window_start asc
}

.create-or-alter function
fn_peak_quiet_hours() {
    traffic_session_enriched_rt()
    | summarize visitors = sum(group_visitor_count)
      by tenant_id, store_id, hour_of_day = hourofday(window_start)
    | order by hour_of_day asc
}

.create-or-alter function
fn_avg_dwell_by_hour() {
    traffic_session_enriched_rt()
    | where has_dwell_flag == true
    | summarize avg_dwell_seconds = avg(dwell_seconds)
      by tenant_id, store_id, hour_of_day = hourofday(window_start), window_start
    | order by window_start asc
}

.create-or-alter function
fn_weekly_traffic_heatmap() {
    traffic_session_enriched_rt()
    | extend
        hour_of_day = hourofday(window_start),
        day_name = case(
            dayofweek(window_start) == 0d, "Sunday",
            dayofweek(window_start) == 1d, "Monday",
            dayofweek(window_start) == 2d, "Tuesday",
            dayofweek(window_start) == 3d, "Wednesday",
            dayofweek(window_start) == 4d, "Thursday",
            dayofweek(window_start) == 5d, "Friday",
            "Saturday"
        )
    | summarize visitors = sum(group_visitor_count)
      by tenant_id, store_id, day_name, hour_of_day
}
