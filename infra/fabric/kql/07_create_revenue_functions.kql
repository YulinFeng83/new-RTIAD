.create-or-alter function fn_store_kpi() {
    store_revenue_5m_mv
    | join kind=fullouter traffic_session_enriched_rt
      on tenant_id, store_id, window_start
    | extend
        transaction_count = coalesce(transaction_count, 0),
        revenue_amount = coalesce(revenue_amount, 0.0),
        group_visitor_count = coalesce(group_visitor_count, 0)
    | extend
        conversion_rate = iff(group_visitor_count == 0, 0.0,
            toreal(transaction_count) * 100.0 / group_visitor_count),
        revenue_per_visitor = iff(group_visitor_count == 0, 0.0,
            revenue_amount / toreal(group_visitor_count))
}

.create-or-alter function fn_basket_by_dwell() {
    pos_events_rt
    | extend ts = todatetime(transaction_timestamp)
    | join kind=inner traffic_session_enriched_rt
      on tenant_id, store_id
    | summarize
        avg_transaction_amount = avg(total_amount)
      by tenant_id, store_id, max_dwell_bucket
}

.create-or-alter function fn_zone_kpi() {
    traffic_session_enriched_rt
    | summarize
        zone_visitors = sum(zone_visitors),
        dwell_sessions = countif(dwell_seconds > 0),
        converted_sessions = countif(has_transaction_flag == true)
      by tenant_id, store_id, zone_id, window_start
    | extend
        dwell_to_conversion_rate =
            iff(zone_visitors == 0, 0.0,
                toreal(converted_sessions) / toreal(zone_visitors))
}

.create-or-alter function fn_promo_roi() {
    traffic_session_enriched_rt
    | summarize
        visitors = count()
      by tenant_id, store_id, window_start, promo_zone_flag
    | join kind=leftouter (
        pos_events_rt
        | extend ts = todatetime(transaction_timestamp)
        | summarize revenue = sum(total_amount)
          by tenant_id, store_id, window_start = bin(ts, 5m)
    ) on tenant_id, store_id, window_start
    | extend revenue = coalesce(revenue, 0.0)
    | summarize
        visitors = sum(visitors),
        revenue = sum(revenue)
      by tenant_id, store_id, promo_zone_flag
    | extend
        revenue_per_visitor = iff(visitors == 0, 0.0,
            revenue / toreal(visitors))
}
