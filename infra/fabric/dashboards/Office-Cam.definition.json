                                        ],
                              "queries":  [
                                              {
                                                  "dataSource":  {
                                                                     "kind":  "inline",
                                                                     "dataSourceId":  "51d68274-ce54-497c-8968-69446f31e13a"
                                                                 },
                                                  "text":  "[\u0027officecam-event\u0027]\n| where todatetime(ts) - 6h \u003e= startofday(now() - 6h)\n| summarize \n    Entered = countif(event_type == \"PERSON_ENTERED\"),\n    Exited = countif(event_type == \"PERSON_EXITED\")\n| extend CurrentOccupancy = max_of(Entered - Exited, 0)",
                                                  "id":  "9921e7ce-7287-4afe-ba65-6626298a3568",
                                                  "usedVariables":  [

                                                                    ]
                                              },
                                              {
                                                  "dataSource":  {
                                                                     "kind":  "inline",
                                                                     "dataSourceId":  "51d68274-ce54-497c-8968-69446f31e13a"
                                                                 },
                                                  "text":  "[\u0027officecam-event\u0027]\n| where todatetime(ts) - 6h \u003e= startofday(now() - 6h)\n| summarize \n    Entered = countif(event_type == \"PERSON_ENTERED\"),\n    Exited = countif(event_type == \"PERSON_EXITED\")\n    by bin(todatetime(ts), 1m)\n| extend NetOccupancy = Entered - Exited\n| order by ts asc\n| extend RunningOccupancy = max_of(row_cumsum(NetOccupancy), 0)\n| project Time=todatetime(ts), RunningOccupancy\n| render areachart with (ycolumns=RunningOccupancy)",
                                                  "id":  "ed8f5b20-49bc-450a-a90d-f93a24390197",
                                                  "usedVariables":  [

                                                                    ]
                                              },
                                              {
                                                  "dataSource":  {
                                                                     "kind":  "inline",
                                                                     "dataSourceId":  "51d68274-ce54-497c-8968-69446f31e13a"
                                                                 },
                                                  "text":  "[\u0027officecam-event\u0027]\n| where todatetime(ts) - 6h \u003e= startofday(now() - 6h)\n// | project ts, event_type, camera_id, zone_id, track_id, cx, cy\n| project ts, event_type, camera_id, zone_id\n| order by todatetime(ts) desc\n| take 100",
                                                  "id":  "6d6164ac-5e8b-4528-a8e0-59fcdb71fd08",
                                                  "usedVariables":  [

                                                                    ]
                                              },
                                              {
                                                  "dataSource":  {
                                                                     "kind":  "inline",
                                                                     "dataSourceId":  "51d68274-ce54-497c-8968-69446f31e13a"
                                                                 },
                                                  "text":  "[\u0027officecam-event\u0027]\n| where todatetime(ts) - 6h \u003e= startofday(now() - 6h)\n| summarize \n    Entered = countif(event_type == \"PERSON_ENTERED\"),\n    Exited = countif(event_type == \"PERSON_EXITED\")\n    by bin(todatetime(ts), 5m)\n| extend NetOccupancy = Entered - Exited\n| order by ts asc\n| extend RunningOccupancy = max_of(row_cumsum(NetOccupancy), 0)\n| summarize AvgOccupancy = round(avg(RunningOccupancy), 1)\n",
                                                  "id":  "951418f9-0145-4ee9-9a88-5c3bc610d6a3",
                                                  "usedVariables":  [

                                                                    ]
                                              }
                                          ]
